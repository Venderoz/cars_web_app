{
  "info": {
    "name": "Cars API",
    "description": "Requests for Cars.API. Run the API and set the baseUrl variable to the server address. Run the Account and Cars folders in order: POST Login Admin saves the JWT in adminToken (used by the Cars folder) and POST Create Car saves the new car id in carId. The 'Account - Email (manual)' folder needs SMTP and tokens copied from Mailtrap.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5127"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "carId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "confirmToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
