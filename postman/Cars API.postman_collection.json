            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test(\"Returns a JWT and the Admin role\", () => {",
                  "    pm.expect(user.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(user.roles).to.include(\"Admin\");",
                  "});",
                  "pm.collectionVariables.set(\"adminToken\", user.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
